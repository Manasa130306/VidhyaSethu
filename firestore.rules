rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.uid.size() <= 128 &&
             data.email is string &&
             data.email.size() <= 150;
    }

    function isValidPaper(data) {
      return data.keys().hasAll(['userId', 'courseName', 'subjectCode', 'universityName', 'examType', 'totalSets', 'sets', 'createdAt', 'userEmail']) &&
             data.userId is string &&
             data.userId.size() <= 128 &&
             data.courseName is string &&
             data.courseName.size() <= 200 &&
             data.subjectCode is string &&
             data.subjectCode.size() <= 50 &&
             data.universityName is string &&
             data.universityName.size() <= 200 &&
             data.examType is string &&
             data.examType.size() <= 100 &&
             (data.userId == 'guest_user' || (isAuthenticated() && data.userId == request.auth.uid)) &&
             data.totalSets is int &&
             data.totalSets >= 0 && data.totalSets <= 10 &&
             data.sets is list &&
             data.sets.size() <= 10 &&
             data.createdAt is string &&
             data.createdAt.size() <= 100 &&
             data.userEmail is string &&
             data.userEmail.size() <= 150;
    }

    // Collection Rules
    match /users/{userId} {
      allow read: if isValidId(userId) && isOwner(userId);
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /generated_papers/{paperId} {
      allow read, write: if true;
    }
  }
}
